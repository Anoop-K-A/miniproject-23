# Environment Variables Template
# Copy this to .env.local and fill in your actual values

# ===================================
# FIREBASE WEB CONFIGURATION
# Get these from: Firebase Console → Project Settings → General → Your apps
# ===================================
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ===================================
# FIREBASE ADMIN SDK CONFIGURATION
# Option 1 (Recommended): Use service account file
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# ===================================
FIREBASE_SERVICE_ACCOUNT_PATH=./backend/firebase-service-account.json

# ===================================
# FIREBASE ADMIN SDK - OPTION 2
# Use environment variables instead of service account file
# Get from: Firebase Console → Project Settings → Service Accounts
# ===================================
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"

# ===================================
# BACKEND SERVER CONFIGURATION
# ===================================
PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ===================================
# EMAIL SERVICE (GMAIL SMTP)
# Required for verification and approval emails
# Use Gmail App Password (Google Account -> Security -> App passwords)
# ===================================
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-16-character-app-password

# ===================================
# OPTIONAL: Database URLs (if using PostgreSQL with Prisma)
# ===================================
# DATABASE_URL=postgresql://user:password@localhost:5432/faculty_portal
# DIRECT_URL=postgresql://user:password@localhost:5432/faculty_portal

# ===================================
# NOTES:
# 1. Never commit .env.local to version control
# 2. Keep your Firebase credentials secure
# 3. Use different projects for development and production
# 4. Update FRONTEND_URL when deploying to production
# 5. For FIREBASE_PRIVATE_KEY, keep the quotes and \n characters
# ===================================
