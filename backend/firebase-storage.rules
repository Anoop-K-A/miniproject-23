# Firebase Storage Rules

# Allow authenticated users to upload files
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Course files - Faculty and admin can upload, anyone authenticated can read
    match /course-files/{courseCode}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && (request.auth.token.role == 'faculty' 
                   || request.auth.token.role == 'admin');
      allow delete: if request.auth != null 
                    && (request.auth.token.role == 'admin'
                    || resource.metadata.uploadedBy == request.auth.uid);
    }
    
    // Event report images
    match /event-reports/{facultyId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && (request.auth.uid == facultyId 
                   || request.auth.token.role == 'admin');
      allow delete: if request.auth != null 
                    && (request.auth.uid == facultyId 
                    || request.auth.token.role == 'admin');
    }
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
